{
    "name": "obelaw/permit",
    "description": "Role and permission management addon for Obelaw Twist.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Obelaw\\Permit\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Obelaw Team",
            "email": "consulting@obelaw.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "obelaw/o-configs": "^1.1",
        "obelaw/trail": "^1.0",
        "obelaw/twist": "^1.2"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obelaw\\Permit\\PermitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
